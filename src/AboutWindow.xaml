<Window x:Class="GameVault.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="关于" Width="600" Height="680" MinWidth="480" MinHeight="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#B6C4D0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeader}" MouseLeftButtonDown="Chrome_Drag">
            <Grid>
                <TextBlock Text="关于" Style="{StaticResource DialogTitle}" />
                <Button Style="{StaticResource DialogCloseButton}" Click="Close_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,16,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="app.ico" Width="72" Height="72" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="一切游戏管理家" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock x:Name="VersionText" FontSize="12" Margin="0,5,0,0"
                                   Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="制作组：雪村落雪 · deepseek" FontSize="12.5" Margin="0,9,0,0"
                                   Foreground="{StaticResource Accent}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="这是什么" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Body}"
                           Text="一个本地运行的、Steam 风格的游戏库管理器。它把散落在硬盘各处的游戏集中到一个界面里，自动从网上抓取简介和封面，支持一键启动、游玩时长统计、分类整理，以及自定义的图片 / MP4 动态壁纸。&#10;&#10;支持扫描本机已安装的 Steam 游戏批量导入，也可以手动添加任意程序。Steam 上没有收录的游戏（例如 Galgame）会自动改用 VNDB、萌娘百科等来源获取信息，简介若不是中文还会自动翻译。&#10;&#10;全部数据都保存在下面这个文件夹里，程序不向任何服务器上传你的游戏库。" />

                <Border Background="{StaticResource Input}" BorderBrush="{StaticResource LineSoft}"
                        BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DataModeText" FontSize="12" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="DataPathText" FontSize="12" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="数据来源" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Body}"
                           Text="游戏资料与图片来自 Steam 公开接口、VNDB（vndb.org）、萌娘百科（zh.moegirl.org.cn）、SteamGridDB 等第三方站点，机器翻译由彩云小译、有道等公开接口提供。这些内容的知识产权归各自权利人所有，本程序仅出于识别和介绍游戏的目的取用。" />

                <TextBlock Text="免责声明" Style="{StaticResource SectionTitle}" />
                <StackPanel x:Name="DisclaimerList" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#131D28" BorderBrush="{StaticResource LineSoft}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Button Content="打开数据目录" Style="{StaticResource TinyButton}"
                        HorizontalAlignment="Left" Click="OpenDataFolder_Click" />
                <Button Content="关闭" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="3" Style="{StaticResource DialogOutline}" />
    </Grid>
</Window>
