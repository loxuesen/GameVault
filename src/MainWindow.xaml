<Window x:Class="GameVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameVault"
        Title="一切游戏管理家" Height="880" Width="1360" MinHeight="620" MinWidth="1040"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType" WindowStyle="None">

    <!--
      The window draws its own minimise / maximise / close buttons in the top bar, so the
      native caption is removed. CaptionHeight matches that bar exactly, which keeps dragging,
      double-click-to-maximise and Aero snap working; controls inside the bar opt back in to
      hit testing individually.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:InverseBoolToVisibility x:Key="NoCover" />

        <!-- ============ sidebar navigation entry ============ -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDeep}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ grid card ============ -->
        <DataTemplate x:Key="CardTemplate">
            <Grid x:Name="Card" Width="182" Margin="0,0,18,24" Background="Transparent" Cursor="Hand"
                  Tag="{Binding}" MouseLeftButtonUp="Card_Click" RenderTransformOrigin="0.5,0.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="272" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="Art" Grid.Row="0" CornerRadius="8" ClipToBounds="True"
                        Background="{StaticResource Panel2}" BorderBrush="#00000000" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="54" FontWeight="Bold" Foreground="#2E4A66"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasCover, Converter={StaticResource NoCover}}" />
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />

                        <Border x:Name="Overlay" Opacity="0" Background="#D90B1119">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                <TextBlock Text="{Binding PlayGlyph}" FontSize="32" Foreground="White"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#9FB3C6"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="Star" Width="28" Height="28" CornerRadius="14" Background="#B30B1119"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Cursor="Hand"
                                Tag="{Binding}" MouseLeftButtonUp="Favorite_Click">
                            <TextBlock x:Name="StarGlyph" Text="★" FontSize="14" Foreground="#6B7D8F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="RunningBadge" Visibility="Collapsed" Background="#D95C7E10"
                                CornerRadius="3" Padding="6,2" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="8">
                            <TextBlock Text="运行中" FontSize="10" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="2,9,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextDim}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter TargetName="StarGlyph" Property="Foreground" Value="#F2C14E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="RunningBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.8" />
                </DataTrigger>
                <Trigger SourceName="Art" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                    <Setter TargetName="Art" Property="BorderBrush" Value="{StaticResource AccentDeep}" />
                    <Setter TargetName="Card" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ list row ============ -->
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8" Margin="0,1"
                    Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Card_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="48" CornerRadius="4" ClipToBounds="True"
                            Background="{StaticResource Panel2}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold" Foreground="#2E4A66"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasCover, Converter={StaticResource NoCover}}" />
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextDim}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding PlayGlyph}" FontSize="15" Margin="10,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />

                    <Border Grid.Column="3" Width="28" Height="28" CornerRadius="14" Background="#14000000"
                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Favorite_Click">
                        <TextBlock x:Name="RowStar" Text="★" FontSize="14" Foreground="#6B7D8F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter TargetName="RowStar" Property="Foreground" Value="#F2C14E" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== wallpaper ============================== -->
        <!-- First child, so it renders behind the sidebar and the library. -->
        <Grid x:Name="WallpaperLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Image x:Name="WallpaperImage" Stretch="UniformToFill" />
            <MediaElement x:Name="WallpaperVideo" Stretch="UniformToFill" Visibility="Collapsed"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True"
                          MediaEnded="WallpaperVideo_MediaEnded" />
            <!-- Keeps text and covers readable over an arbitrary user image, without
                 crushing the wallpaper into a flat dark wash. -->
            <Border Background="#66000000" />
        </Grid>

        <!-- ============================== sidebar ============================== -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource Sidebar}"
                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,14">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,14">
                    <Image Source="app.ico" Width="30" Height="30" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="一切游戏管理家" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock x:Name="StatLine" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" />
                    <TextBlock x:Name="SearchHint" Text="搜索名称、简介、分类…" IsHitTestVisible="False"
                               Foreground="{StaticResource TextDim}" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" />

                <TextBlock DockPanel.Dock="Top" Text="分类" FontSize="11" Margin="6,14,0,6"
                           Foreground="{StaticResource TextDim}" />

                <ScrollViewer DockPanel.Dock="Top" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryPanel" />
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="＋  添加游戏" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                    <Button Content="扫描 Steam 库" Style="{StaticResource TinyButton}" Margin="0,7,0,0" Click="Scan_Click" />
                    <Button Content="补全简介与封面" Style="{StaticResource TinyButton}" Margin="0,7,0,0" Click="Enrich_Click" />
                    <Button Content="设置" Style="{StaticResource TinyButton}" Margin="0,7,0,0" Click="Settings_Click" />
                    <Button Content="关于" Style="{StaticResource TinyButton}" Margin="0,7,0,0" Click="About_Click" />
                </StackPanel>

                <!-- Filler keeps the bottom stack pinned to the bottom edge. -->
                <Grid />
            </DockPanel>
        </Border>

        <!-- ============================== main ============================== -->
        <DockPanel Grid.Column="1">
            <Border x:Name="TopBarPanel" DockPanel.Dock="Top" Background="{StaticResource TopBar}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Height="52">
                <Grid>
                    <TextBlock x:Name="Crumbs" Text="全部游戏" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="22,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="排序" FontSize="12" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="SortBox" Width="132" SelectionChanged="Sort_Changed"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                            <ComboBoxItem Content="最近游玩" />
                            <ComboBoxItem Content="最近添加" />
                            <ComboBoxItem Content="名称" />
                            <ComboBoxItem Content="游玩时长" />
                        </ComboBox>
                        <RadioButton x:Name="GridViewButton" Style="{StaticResource NavRadio}" Margin="14,0,0,0"
                                     IsChecked="True" Click="View_Changed" Tag="grid" Padding="9,5"
                                     WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="▦" FontSize="14" />
                        </RadioButton>
                        <RadioButton x:Name="ListViewButton" Style="{StaticResource NavRadio}" Margin="2,0,14,0"
                                     Click="View_Changed" Tag="list" Padding="9,5"
                                     WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="☰" FontSize="14" />
                        </RadioButton>
                        <Border Width="1" Margin="0,14" Background="{StaticResource LineSoft}" />
                        <Button x:Name="MinimizeButton" Content="─" Style="{StaticResource WindowControlButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"
                                ToolTip="最小化" />
                        <Button x:Name="MaximizeButton" Content="▢" Style="{StaticResource WindowControlButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"
                                ToolTip="最大化" />
                        <Button Content="✕" Style="{StaticResource WindowCloseButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"
                                ToolTip="关闭" AutomationProperties.Name="关闭窗口" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="22,18,12,40">
                <StackPanel>
                    <!-- continue-playing banner -->
                    <Border x:Name="HeroBox" Height="250" CornerRadius="8" Margin="0,0,10,24"
                            ClipToBounds="True" Visibility="Collapsed" Background="{StaticResource Panel}">
                        <Grid>
                            <Image x:Name="HeroImage" Stretch="UniformToFill" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F20A0F16" Offset="0" />
                                        <GradientStop Color="#B80A0F16" Offset="0.45" />
                                        <GradientStop Color="#260A0F16" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="28,0" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="继续游戏" FontSize="12" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="HeroTitle" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,10"
                                           Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroText" FontSize="13" Foreground="#AFC0CF" MaxHeight="62"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="HeroPlay" Content="▶  开始游戏" Style="{StaticResource PrimaryButton}"
                                            Click="HeroPlay_Click" />
                                    <Button x:Name="HeroDetail" Content="查看详情" Margin="10,0,0,0" Click="HeroDetail_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="GameList" />

                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,60,0,0"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle" Text="游戏库还是空的" FontSize="20"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource TextDim}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="460" />
                        <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Button Content="扫描 Steam 库" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                            <Button Content="添加游戏" Margin="10,0,0,0" Click="Add_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============================== overlays ============================== -->
        <Border x:Name="JobBar" Grid.Column="1" Visibility="Collapsed" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                Padding="16,11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="JobLabel" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                <ProgressBar x:Name="JobProgress" Width="180" Margin="14,0" VerticalAlignment="Center" />
                <TextBlock x:Name="JobCount" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="Toast" Grid.Column="1" Visibility="Collapsed" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                Padding="14,11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"
                MaxWidth="380">
            <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
